# Server-side only. Never expose these with a NEXT_PUBLIC_ prefix.
ANTHROPIC_API_KEY=            # monthly insights job only (examples/insights-prompt.md)
ANTHROPIC_MODEL=              # choose the current model when you build the job
CRON_SECRET=                  # shared secret the cron route checks, so nobody else can trigger the rollup

# Client-side settings live in window.HX_CONFIG (see docs/04), not in the environment:
#   trackEndpoint: '/api/collect'      tracking is OFF while this is empty
#   talkEndpoint:  '/api/talk'         the "Talk to us" form is a preview while this is empty
#   variant:       'A' | 'control'     set by whatever splits traffic (docs/03)
#   captureNote:   true | false        send the scrubbed step-5 note with the answers
